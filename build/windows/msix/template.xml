<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="arkpeak"
        Arguments=""
        InstallLocation="C:\Program Files\ArkPeak\ArkPeak">
    </Installer>
    <PackageInformation
        PackageName="ArkPeak"
        PackageDisplayName="ArkPeak"
        PublisherName="CN=ArkPeak"
        PublisherDisplayName="ArkPeak"
        Version="0.1.0.0"
        PackageDescription="A arkpeak application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.incurl.arkpeak"
                Description="A arkpeak application"
                DisplayName="ArkPeak"
                ExecutableName="arkpeak"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ArkPeak</DisplayName>
            <PublisherDisplayName>ArkPeak</PublisherDisplayName>
            <Description>A arkpeak application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="arkpeak.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
